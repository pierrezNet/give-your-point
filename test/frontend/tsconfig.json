{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "lib": ["ESNext", "DOM"],
    "types": ["node"]
  },
  "include": ["./**/*.ts"]
}
