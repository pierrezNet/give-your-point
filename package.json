{
  "name": "give-your-point",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "dev": "npm run build && wrangler pages dev public --persist-to=./db_data",
    "db:init": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=init_db.sql",
    "db:seed": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=seed.sql",
    "db:reset": "npm run db:init && npm run db:seed",
    "db:pull": "wrangler d1 export give-your-point-eu --remote --output=prod_backup.sql && rm -rf db_data && wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=prod_backup.sql",
    "db:migrate:multitenant": "wrangler d1 execute give-your-point-eu --remote --file=migrations/2026-05-multitenant.sql",
    "db:migrate:multitenant:local": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=migrations/2026-05-multitenant.sql",
    "db:migrate:superadmin": "wrangler d1 execute give-your-point-eu --remote --file=migrations/2026-06-superadmin.sql",
    "db:migrate:superadmin:local": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=migrations/2026-06-superadmin.sql",
    "db:migrate:owner": "wrangler d1 execute give-your-point-eu --remote --file=migrations/2026-07-owner.sql",
    "db:migrate:owner:local": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=migrations/2026-07-owner.sql",
    "db:migrate:email": "wrangler d1 execute give-your-point-eu --remote --file=migrations/2026-08-email.sql",
    "db:migrate:email:local": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=migrations/2026-08-email.sql",
    "db:cleanup-inactive": "wrangler d1 execute give-your-point-eu --remote --file=migrations/cleanup-inactive.sql",
    "db:cleanup-inactive:local": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=migrations/cleanup-inactive.sql",
    "db:migrate:i18n": "wrangler d1 execute give-your-point-eu --remote --file=migrations/2026-09-i18n.sql",
    "db:migrate:i18n:local": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=migrations/2026-09-i18n.sql",
    "db:migrate:analytics": "wrangler d1 execute give-your-point-eu --remote --file=migrations/2026-10-analytics.sql",
    "db:migrate:analytics:local": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=migrations/2026-10-analytics.sql",
    "db:migrate:invite": "wrangler d1 execute give-your-point-eu --remote --file=migrations/2026-11-invite.sql",
    "db:migrate:invite:local": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=migrations/2026-11-invite.sql",
    "db:migrate:email-verify": "wrangler d1 execute give-your-point-eu --remote --file=migrations/2026-12-email-verify.sql",
    "db:migrate:email-verify:local": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=migrations/2026-12-email-verify.sql",
    "db:migrate:point-reason": "wrangler d1 execute give-your-point-eu --remote --file=migrations/2026-13-point-reason.sql",
    "db:migrate:point-reason:local": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=migrations/2026-13-point-reason.sql",
    "generate:vapid": "node generate-vapid.mjs",
    "deploy": "npm run build && wrangler pages deploy public",
    "build": "npx @tailwindcss/cli -i public/input.css -o public/styles.css --minify",
    "db:migrate:split-token": "wrangler d1 execute give-your-point-eu --remote --file=migrations/2026-14-split-token.sql",
    "db:migrate:split-token:local": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=migrations/2026-14-split-token.sql",
    "db:migrate:indexes": "wrangler d1 execute give-your-point-eu --remote --file=migrations/2026-15-indexes.sql",
    "db:migrate:indexes:local": "wrangler d1 execute give-your-point-eu --local --persist-to=./db_data --file=migrations/2026-15-indexes.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "hono": "^4.11.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^4.20260128.0",
    "@tailwindcss/cli": "^4.2.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.62.0"
  },
  "engines": {
    "node": ">=24"
  }
}
